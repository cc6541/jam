{
  "model": "sonnet",
  "effortLevel": "medium",
  "env": {
    "RTK_SUPPRESS_HOOK_WARNING": "1",
    "RTK_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm levels:validate)",
      "Bash(pnpm levels:stats)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./pnpm-lock.yaml)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/coverage/**)",
      "Read(./**/.turbo/**)",
      "Read(./apps/*/ios/**)",
      "Read(./apps/*/android/**)",
      "Read(./apps/*/levels/**)",
      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.webp)",
      "Read(./**/*.mp3)",
      "Read(./**/*.ogg)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude/session-brief.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude/quiet-check.sh\""
          }
        ]
      }
    ]
  }
}
