{
  "name": "jam-factory-studio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "check": "turbo run typecheck lint test --output-logs=errors-only",
    "build": "turbo run build --output-logs=errors-only",
    "test": "turbo run test --output-logs=errors-only",
    "typecheck": "turbo run typecheck --output-logs=errors-only",
    "lint": "turbo run lint --output-logs=errors-only",
    "levels:validate": "pnpm -s --filter @jam/level-tools validate",
    "levels:stats": "pnpm -s --filter @jam/level-tools stats"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "type": "module"
}
